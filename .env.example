# Скопируйте в .env и заполните. Файл .env не публиковать и не добавлять в репозиторий.

# Адрес сайта: домен должен указывать на IP сервера, порты 80 и 443 открыты. Для проверки на своём компьютере: localhost
DOMAIN=kadry.example.kg

# Обязательно: длинная случайная строка. Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Первый администратор (создаётся при первом запуске, если пользователей ещё нет). После входа смените пароль и удалите ADMIN_PASSWORD отсюда.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# Часовой пояс для ежедневных задач (копия в 02:00, напоминания в 08:00)
TZ=Asia/Bishkek

# Почта для напоминаний (необязательно, без неё напоминания только на главной странице)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_URL=https://kadry.example.kg

# Копии базы: сколько хранить и команда выгрузки за пределы сервера (путь новой копии добавляется последним аргументом).
BACKUP_KEEP=14
BACKUP_UPLOAD_CMD=

# Если запускаете без HTTPS (только для проверки): COOKIE_SECURE=0
COOKIE_SECURE=1
